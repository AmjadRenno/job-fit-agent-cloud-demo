# Copy this file to .env and replace the placeholder values before running anything.
# .env is gitignored — never commit real values.

# Public portfolio default: read-only synthetic demo mode.
APP_MODE=demo

POSTGRES_DB=jobfit
POSTGRES_USER=jobfit
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://jobfit:replace-with-a-local-password@localhost:5433/jobfit

# Optional server-side dashboard authorization token for non-demo modes only.
DASHBOARD_TOKEN=replace-with-a-local-dashboard-token

# OpenAI API key — used only for job analysis and cover-letter generation.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Explicitly opt in only for the bounded, read-only agentic fallback.
ENABLE_AGENTIC_SEARCH=false
# Comma-separated explicit browser origins; wildcard origins are rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
